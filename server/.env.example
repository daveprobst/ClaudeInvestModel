# Copy to .env (never commit). Everything is optional: with no keys the server runs in demo-only mode.
PORT=8787
SITE_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
DEMO_ENABLED=true
# Stripe TEST mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
PRICE_AMOUNT=900
PRICE_CURRENCY=chf
# Optional e-mail sign-in links (https://resend.com)
# RESEND_API_KEY=re_...
# MAIL_FROM=Bulwark <noreply@yourdomain.com>
